#!/bin/sh
# Horizon for shader debugging: the settings and shader-pack screens draw no dimming behind
# them, so a shader pack is judged on the world it is drawn on.
#
# What it does, in order:
#   1. installs and turns on a small resource pack that blanks the menu background textures
#      (`gui/inworld_menu_background`, `gui/menu_background`, the list and options backgrounds),
#      so the tiled backdrop and the vanilla panels are gone;
#   2. starts Horizon through the launcher with HORIZON_MENU_STYLE=vanilla. The 18 November build
#      (`0b14f8a`) and newer honour it: their settings pages draw on vanilla's surfaces, which
#      skip the veil (`graphics_style::veil_over` returns early for them). Older builds ignore
#      the variable, and there only the resource pack takes effect (the veil stays), so the
#      script says so;
#   3. passes the version and the rest of the command line through.
#
#   horizon-for-shader-debug                 # the newest installed version
#   horizon-for-shader-debug 9f42064         # any installed version, by a part of its name
#   horizon-for-shader-debug 9f42064 --world Test
#   horizon-for-shader-debug --dry-run       # print what would run, install nothing
#
# Env: HORIZON_LAUNCHER (default ~/Minecraft/horizon-launcher), HORIZON_PACK (default
#      see_through_settings.zip), HORIZON_DATA (default ~/.local/share/horizon-launcher).
set -eu

launcher=${HORIZON_LAUNCHER:-$HOME/Minecraft/horizon-launcher}
pack=${HORIZON_PACK:-see_through_settings.zip}
data=${HORIZON_DATA:-$HOME/.local/share/horizon-launcher}

dry=0
if [ "${1:-}" = "--dry-run" ]; then
    dry=1
    shift
fi
wanted=${1:-}
if [ -n "$wanted" ]; then
    shift
fi

[ -x "$launcher" ] || {
    echo "no launcher at $launcher (set HORIZON_LAUNCHER)" >&2
    exit 1
}

