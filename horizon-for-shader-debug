# The installed versions, newest first; a picked one may be named by any part of its name.
version=$(
    "$launcher" versions --installed --json |
        python3 -c '
import json, sys
installed = json.load(sys.stdin)["installed"]
wanted = sys.argv[1]
if not wanted:
    print(installed[0] if installed else "")
    sys.exit(0)
for name in installed:
    if name.lower() == wanted.lower():
        print(name)
        sys.exit(0)
matches = [n for n in installed if wanted.lower() in n.lower()]
# Native builds of a version carry its commit too: a plain build is the one wanted by default.
plain = [n for n in matches if not n.startswith("native-")]
matches = plain or matches
if len(matches) == 1:
    print(matches[0])
elif matches:
    print("several versions match %r: %s" % (wanted, ", ".join(matches)), file=sys.stderr)
    sys.exit(1)
else:
    print("no installed version matches %r. Installed: %s" % (wanted, ", ".join(installed)), file=sys.stderr)
    sys.exit(1)
' "$wanted"
) || exit 1

[ -n "$version" ] || {
    echo "no Horizon version is installed yet" >&2
    exit 1
}

# The surfaces look needs the variable compiled in: the 13 November build has no such code.
dir=$data/versions/$version
old_build=0
if [ -d "$dir" ] && ! grep -qas HORIZON_MENU_STYLE "$dir"/*.so "$dir"/horizon-client 2>/dev/null; then
    old_build=1
fi

if [ "$dry" = 1 ]; then
    echo "version: $version"
    echo "pack:    $pack (installed and turned on if missing)"
    if [ "$old_build" = 1 ]; then
        echo "note:    this build predates the surfaces look (18 November, 0b14f8a); the veil stays"
    fi
    echo "run:     $launcher play --version $version $*"
    exit 0
fi

# The transparent background textures: install them once, then keep them on.
if ! "$launcher" packs list 2>/dev/null | grep -q "$pack"; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT INT TERM
    pack_zip "$tmp/$pack"
    "$launcher" packs add "$tmp/$pack" >/dev/null
fi
"$launcher" packs on "$pack" >/dev/null 2>&1 || true

if [ "$old_build" = 1 ]; then
    echo "note: $version predates the surfaces look (18 November build, 0b14f8a)." >&2
    echo "      The veil stays there; only the resource pack takes effect." >&2
fi

exec env HORIZON_MENU_STYLE=vanilla "$launcher" play --version "$version" "$@"
